# Copy to backend/.env. Every value can also be set as an environment variable.
ENVIRONMENT=development
REPORT_BRAND=Vastu Plan Analyzer

# SQLite needs no setup. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://vastu:vastu@localhost:5432/vastu
DATABASE_URL=sqlite:///./vastu_dev.db
AUTO_CREATE_TABLES=true
AUTO_SEED=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# Storage: local (HMAC-signed /files URLs) or s3 (presigned URLs; MinIO works)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:8000
SIGNED_URL_TTL_SECONDS=600
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=   # only if browsers reach storage via a different host
# S3_BUCKET=vastu-private
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Uploads
MAX_UPLOAD_MB=15
MIN_IMAGE_SIDE=300

# Jobs: inline (FastAPI background tasks, dev) or celery (needs Redis + a worker)
JOB_MODE=inline
REDIS_URL=redis://localhost:6379/0
JOB_MAX_ATTEMPTS=3

# AI detection: mock (fixed demo layout) or anthropic (vision model)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=90

RATE_LIMIT_PER_MINUTE=240
UPLOAD_RATE_LIMIT_PER_MINUTE=12
